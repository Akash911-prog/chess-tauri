+        // En passant is the one move that vacates two squares at once (the
+        // capturer's origin AND the captured pawn's square, which isn't the
+        // destination). That can expose the king along a rank even when
+        // neither pawn looks pinned individually — the standard pin
+        // algorithm only removes FRIENDLY pieces for its x-ray, so it never
+        // considers the enemy pawn about to be captured as removable. This
+        // has to be checked directly by simulating the resulting occupancy.
+        let hypothetical_occ =
+            (self.total_occupency & !(1u64 << from) & !(1u64 << capturing_idx)) | (1u64 << to);
+
+        let king_idx =
+            self.pieces[self.player_turn as usize][PieceKind::King as usize].lsb() as usize;
+        let enemy = (self.player_turn ^ 1) as usize;
+        let queen_board = self.pieces[enemy][PieceKind::Queen as usize];
+
+        let rook_ray = self.move_gen.gen_rook_attacks(king_idx, hypothetical_occ);
+        let exposes_king = (BitBoard(rook_ray)
+            & (self.pieces[enemy][PieceKind::Rook as usize] | queen_board))
+            != 0;
+
+        !exposes_king
     }
 
